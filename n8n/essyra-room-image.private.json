        "jsCode": "const id=$input.first().json.event_id;if(typeof id!=='string'||!/^[a-zA-Z0-9-]{1,100}$/.test(id))throw Error('IMAGE_REQUEST_NOT_ACCEPTED');return [{json:{eventId:id,sessionHash:$('Plan finished room image').first().json.session_hash}}];"
