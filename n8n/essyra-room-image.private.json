      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prepare validated room upload').first().json;const room=$('Upload room reference').first().json.body?.[0],item=$input.first().json.body?.[0];if(typeof room!=='string'||typeof item!=='string')throw Error('IMAGE_UPLOAD_FAILED');const prompt='Edit image 1, the original room photograph. Place exactly one '+p.productName+' from image 2 in a suitable usable area as a professional interior designer. Image 2 is the product reference: extract only this furniture object and discard its original background. Preserve its structure, finish, upholstery, colour and legs. Choose sensible scale and orientation from the room perspective, maintain access to doors and walking space, and match lighting with realistic contact shadows. Preserve room architecture, windows and existing furniture. Do not add unrelated products, labels, text or watermarks. This is an illustrative design, not a measurement guarantee.';return [{json:{fn_index:p.fnIndex,session_hash:p.jobId.replaceAll('-',''),data:[prompt,[{image:{path:room,meta:{_type:'gradio.FileData'}},caption:null},{image:{path:item,meta:{_type:'gradio.FileData'}},caption:null}],'Distilled (4 steps)',47,false,768,768,4,1,false]}}];"
      }
