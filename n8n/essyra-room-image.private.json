    {
      "id": "df8964f1-823d-4f46-84bd-984b4ede3b46",
      "name": "Return finished image reference",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json.data;if(typeof raw!=='string'||raw.length>200000)throw Error('INVALID_IMAGE_REPLY');let output;for(const block of raw.replace(/\\r\\n/g,'\\n').split('\\n\\n')){const line=block.split('\\n').find(l=>l.startsWith('data:'));if(!line)continue;try{const v=JSON.parse(line.slice(5));if(v.msg==='process_completed')output=v;}catch{}}if(!output?.success)return [{json:{status:'unavailable',reason:'The free image service could not finish this design. Please try later.'}}];const url=output.output?.data?.[0]?.url;if(typeof url!=='string'||!/^https:\\/\\/black-forest-labs-flux-2-klein-4b\\.hf\\.space\\/gradio_api\\/file=\\/tmp\\/gradio\\/[a-f0-9]{64}\\/[a-zA-Z0-9_.-]+$/.test(url))throw Error('INVALID_RESULT_URL');const p=$('Validate image inputs').first().json;return [{json:{status:'completed',jobId:p.jobId,productSlug:p.productSlug,imageUrl:url,illustrative:true}}];"
      }
    },
    {
      "id": "39df9139-de25-47b6-b71d-081f926bc5e1",
      "name": "Private image processing notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -420
      ],
      "parameters": {
        "content": "## ESSYRA Design Studio — room images\nLocal webhook only. The website must authenticate ownership, verify the selected active catalogue product, preserve the existing quota, and record explicit external image-processing consent before forwarding.\n\nGroq checks room suitability first. Rejected photos never reach the image editor. FLUX then receives the room and selected product photos. No paid fallback or Hugging Face token is sent.\n\nFree shared GPU access has limits and downtime. Copy accepted results into private owner-restricted website storage. Keep the finished result separate from manual canvas edits.\n\nNo customer images or provider credentials belong in exported workflow JSON or GitHub.",
        "width": 650,
        "height": 350
      }
    }
