    {
      "id": "10ce34f4-11db-431f-a078-d68bb69fff4a",
      "name": "Prepare validated room upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const dep=$input.first().json.dependencies?.find(d=>d.api_name==='infer');if(!dep||dep.inputs?.length!==10||!Number.isInteger(dep.id))throw Error('IMAGE_API_CHANGED');const original=$('Validate image inputs').first();return [{json:{fnIndex:dep.id,jobId:original.json.jobId,productSlug:original.json.productSlug,productName:original.json.productName},binary:{data:original.binary.room}}];"
      }
    },
