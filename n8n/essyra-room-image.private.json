    {
      "id": "3f29d0e4-1a83-4e79-b6d1-c9f0784e9b8d",
      "name": "Decide whether placement is suitable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json.choices?.[0]?.message?.content;if(typeof raw!=='string'||raw.length>4000)throw Error('INVALID_VISION_REPLY');const v=JSON.parse(raw);const accepted=v.isRoom===true&&v.clearEnough===true&&v.placementAreaVisible===true&&Number(v.confidence)>=0.8;return [{json:{accepted,reason:typeof v.reason==='string'?v.reason.slice(0,180):'Please upload a clear room photograph showing a suitable placement area.'}}];"
      }
    },
    {
      "id": "62d8bb0e-e67e-4a12-a5a5-9272a593c024",
      "name": "Suitable room photograph?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c4c84253-9bbc-4f65-98e0-36112cf1dda5",
              "leftValue": "={{ $json.accepted }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3e269e7-ade8-4dfc-9f0a-0e3803da59ba",
